%% System architecture for report section 2.3 (render: docs/images/system-architecture.png)
%% Vertical layout so it stays readable at A4 text width. Step numbers (1-7) are in the node text and match docs/Architecture.md.
%% Group boxes have no title: arrows entering a titled box would cross its title, so the names are in the nodes.
%%{init: {"theme": "neutral", "themeVariables": {"fontSize": "20px"}, "flowchart": {"nodeSpacing": 25, "rankSpacing": 40, "padding": 10}}}%%
flowchart TB
    subgraph CLIENT[" "]
        direction LR
        PAGES["Browser:<br/>index.html<br/>forecast.html"] --> JS["ES modules<br/>api.js"]
    end

    CDN["CDNs: Leaflet, Chart.js<br/>Map tiles: OSM / CARTO"]

    subgraph SERVER[" "]
        STATIC["1 FastAPI<br/>static files"]
        ROUTERS["2 FastAPI routers<br/>(GET /api): health,<br/>locations, current,<br/>forecast, overview"]
        DB[("3 SQLite<br/>Location, 15 cities")]
        SVC["4 WeatherService<br/>(same process)"]
        CACHE["5 Weather cache 15 min<br/>AQ cache 1 h<br/>single-flight, cooldown 5 min,<br/>last-good up to 6 h"]
        OMC["6 OpenMeteoClient<br/>httpx, 10 s timeout"]
    end

    subgraph OM[" "]
        direction LR
        FC["7 Open-Meteo<br/>Forecast API<br/>current: 8 vars<br/>hourly + daily, 8 days<br/>Asia/Ho_Chi_Minh"]
        AQ["7 Open-Meteo<br/>Air Quality API<br/>pm2_5, us_aqi<br/>5 days, GMT"]
    end

    JS -.-> CDN
    JS --> STATIC
    JS --> ROUTERS
    ROUTERS --> DB
    ROUTERS --> SVC
    SVC --> CACHE
    CACHE --> OMC
    OMC --> FC
    OMC --> AQ
