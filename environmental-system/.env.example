# Copy to `.env` (same folder) to override defaults; `.env` is not committed.
# Every variable has a default in app/config.py, so the app runs without a .env.

# DATABASE_URL=sqlite:///./weather.db
# CACHE_TTL_SECONDS=900
# HTTP_TIMEOUT_SECONDS=10
# LOG_LEVEL=INFO

# Only needed when the frontend runs on another port (e.g. VS Code Live Server):
# CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
