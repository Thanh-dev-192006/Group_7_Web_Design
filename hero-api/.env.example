# Copy thành `.env` (cùng thư mục) nếu cần đổi giá trị mặc định. `.env` không được commit.
# Mọi biến đều có mặc định trong app/config.py — không có .env app vẫn chạy.

# DATABASE_URL=sqlite:///./weather.db
# CACHE_TTL_SECONDS=900
# HTTP_TIMEOUT_SECONDS=10
# LOG_LEVEL=INFO

# Chỉ cần khi chạy frontend ở port khác (VD VS Code Live Server):
# CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500"]
